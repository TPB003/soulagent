# Server-only. Never prefix these with NEXT_PUBLIC_.

# Xiaomi MiMo. Required for live /api/chat and /api/generate replies.
XIAOMI_API_KEY=
# OpenAI-compatible base URL (https only).
XIAOMI_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# Base Sepolia JSON-RPC used by /api/chat to call getAgent.
BASE_RPC_URL=https://sepolia.base.org

# Abuse gate: "origin" (default) allows only this site's browser calls,
# plus origins listed below. "off" disables the check.
# This is not authentication — a non-browser client can spoof Origin.
# Rate limits are what cap spend. See README.
API_ABUSE_GATE=origin
ALLOWED_ORIGINS=

# Fixed-window limits per IP. Invalid values fall back to these defaults.
RATE_LIMIT_CHAT_MAX=20
RATE_LIMIT_CHAT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=6
RATE_LIMIT_GENERATE_WINDOW_SEC=60

# Optional distributed counter. Accepts Upstash Redis REST, or Vercel KV
# (KV_REST_API_URL / KV_REST_API_TOKEN) when the Upstash pair is empty.
# Both URL and token must be set, and the URL must be https.
# If they are unset or the store errors, the route uses an in-memory window
# on that server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
